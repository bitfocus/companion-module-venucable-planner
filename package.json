{
	"name": "companion-module-venucable-planner",
	"version": "1.7.1",
	"description": "Bitfocus Companion module for VenuCable: add kit to the plan and run the live running order from a Stream Deck",
	"type": "module",
	"main": "src/main.js",
	"scripts": {
		"test": "node --import ./test/register.js --test --test-timeout=15000 \"test/*.test.js\"",
		"package": "companion-module-build",
		"release": "companion-module-build && mkdir -p release && mv venucable-planner-*.tgz release/companion-module-venucable.tgz",
		"format": "prettier -w .",
		"lint": "eslint .",
		"pages": "node scripts/pages.js",
		"icons": "node scripts/icons.js"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-venucable-planner.git"
	},
	"engines": {
		"node": "^22",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~1.12.1",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^2.8.0",
		"eslint": "^9.39.5",
		"prettier": "^3.9.9"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
